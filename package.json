{
  "name": "commentia",
  "version": "0.1.0",
  "private": true,
  "description": "リアルタイムコメント投稿アプリケーション",
  "workspaces": [
    "packages/frontend",
    "packages/backend",
    "packages/infrastructure",
    "packages/shared"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "jest --config tests/integration/jest.config.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:setup": "./scripts/setup-test-env.sh",
    "test:cleanup": "./scripts/cleanup-test-env.sh",
    "test:full": "npm run test:setup && npm run test:integration && npm run test:e2e; npm run test:cleanup",
    "test:smoke": "./scripts/test-smoke.sh",
    "test:performance": "./scripts/test-performance.sh",
    "lint": "biome check --apply .",
    "format": "biome format --write .",
    "type-check": "npm run type-check --workspaces",
    "dev": "npm run dev -w packages/frontend",
    "backend:build": "npm run build -w packages/backend",
    "infra:synth": "npm run synth -w packages/infrastructure",
    "infra:deploy": "npm run deploy -w packages/infrastructure",
    "infra:deploy:dev": "npm run deploy:dev -w packages/infrastructure",
    "infra:deploy:staging": "npm run deploy:staging -w packages/infrastructure",
    "infra:deploy:prod": "npm run deploy:prod -w packages/infrastructure",
    "clean": "npm run clean --workspaces"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.2.0",
    "@playwright/test": "^1.48.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "ws": "^8.18.0",
    "@types/ws": "^8.5.12",
    "axios": "^1.7.7",
    "wait-port": "^1.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/commentia/commentia.git"
  },
  "author": "Commentia Team",
  "license": "MIT"
}
