# Commentia Infrastructure Environment Variables
# Copy this file to .env.dev, .env.staging, or .env.prod and configure accordingly

# =====================================
# AWS Configuration
# =====================================
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# =====================================
# Deployment Configuration
# =====================================
STAGE=dev
STACK_NAME_PREFIX=commentia

# =====================================
# Custom Domain Configuration (Optional)
# =====================================
# Production
# CUSTOM_DOMAIN_NAME=commentia.example.com
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Staging
# CUSTOM_DOMAIN_NAME=staging.commentia.example.com
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy

# =====================================
# Database Configuration
# =====================================
# Encryption (auto-enabled for staging/prod)
ENABLE_ENCRYPTION=false

# Deletion Protection (auto-enabled for prod)
ENABLE_DELETION_PROTECTION=false

# Backup Retention (days)
BACKUP_RETENTION_DAYS=7

# DynamoDB Configuration
DYNAMODB_BILLING_MODE=PAY_PER_REQUEST
ENABLE_POINT_IN_TIME_RECOVERY=false

# =====================================
# Lambda Configuration
# =====================================
LAMBDA_RUNTIME=nodejs22.x
LAMBDA_ARCHITECTURE=arm64
LAMBDA_MEMORY_SIZE_DEV=128
LAMBDA_MEMORY_SIZE_STAGING=256
LAMBDA_MEMORY_SIZE_PROD=512
LAMBDA_TIMEOUT=30

# =====================================
# API Gateway Configuration
# =====================================
# Rate Limiting (requests per second)
API_THROTTLE_RATE_LIMIT_DEV=100
API_THROTTLE_RATE_LIMIT_STAGING=500
API_THROTTLE_RATE_LIMIT_PROD=1000

# Burst Limiting
API_THROTTLE_BURST_LIMIT_DEV=200
API_THROTTLE_BURST_LIMIT_STAGING=1000
API_THROTTLE_BURST_LIMIT_PROD=2000

# =====================================
# CloudFront Configuration
# =====================================
# Price Class
CLOUDFRONT_PRICE_CLASS_DEV=PriceClass_100
CLOUDFRONT_PRICE_CLASS_STAGING=PriceClass_200
CLOUDFRONT_PRICE_CLASS_PROD=PriceClass_All

# Logging
ENABLE_CLOUDFRONT_LOGGING=false

# =====================================
# Security Configuration
# =====================================
# WAF (Web Application Firewall) - Production only
ENABLE_WAF=false
WAF_WEB_ACL_ARN=

# SSL/TLS
MINIMUM_PROTOCOL_VERSION=TLSv1.2_2021

# =====================================
# Monitoring Configuration
# =====================================
# X-Ray Tracing
ENABLE_XRAY_TRACING=true

# CloudWatch Alarms
ENABLE_CLOUDWATCH_ALARMS=true

# Log Retention (days)
LOG_RETENTION_DAYS_DEV=3
LOG_RETENTION_DAYS_STAGING=7
LOG_RETENTION_DAYS_PROD=30

# Lambda Insights (disabled for dev)
ENABLE_LAMBDA_INSIGHTS=false

# =====================================
# Cost Optimization
# =====================================
# Reserved Concurrency
LAMBDA_RESERVED_CONCURRENCY_DEV=
LAMBDA_RESERVED_CONCURRENCY_STAGING=50
LAMBDA_RESERVED_CONCURRENCY_PROD=100

# Provisioned Concurrency (prod only)
LAMBDA_PROVISIONED_CONCURRENCY_PROD=

# =====================================
# Tagging
# =====================================
PROJECT_NAME=Commentia
TEAM_NAME=commentia-team
COST_CENTER=commentia-dev
OWNER_EMAIL=team@commentia.example.com

# =====================================
# Development/Testing Configuration
# =====================================
# LocalStack (for local development)
LOCALSTACK_ENDPOINT=http://localhost:4566
DYNAMODB_ENDPOINT=http://localhost:8000

# Testing
RUN_INTEGRATION_TESTS=false
TEST_DATA_RETENTION_DAYS=1

# =====================================
# Feature Flags
# =====================================
# Enable/disable specific features
ENABLE_CUSTOM_METRICS=true
ENABLE_DEAD_LETTER_QUEUES=true
ENABLE_VPC_CONFIGURATION=false
ENABLE_EFS_FILESYSTEM=false

# =====================================
# Network Configuration (Advanced)
# =====================================
# VPC Configuration (if enabled)
VPC_ID=
PRIVATE_SUBNET_IDS=
PUBLIC_SUBNET_IDS=
SECURITY_GROUP_IDS=

# =====================================
# External Integrations
# =====================================
# Email notifications (future feature)
SES_EMAIL_ADDRESS=
SNS_TOPIC_ARN=

# Analytics (future feature)
GOOGLE_ANALYTICS_ID=
HOTJAR_ID=

# Error Reporting (future feature)
SENTRY_DSN=
BUGSNAG_API_KEY=

# =====================================
# CI/CD Configuration
# =====================================
# GitHub Actions
GITHUB_REPOSITORY=
GITHUB_TOKEN=

# Deployment notifications
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# =====================================
# Environment Specific Overrides
# =====================================
# Development specific settings
# ENABLE_DEBUG_LOGGING=true
# CORS_ALLOW_ALL_ORIGINS=true

# Staging specific settings
# ENABLE_PERFORMANCE_MONITORING=true
# ENABLE_LOAD_TESTING=true

# Production specific settings
# ENABLE_HIGH_AVAILABILITY=true
# ENABLE_MULTI_REGION=false
# ENABLE_DISASTER_RECOVERY=true